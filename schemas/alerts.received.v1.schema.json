{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PayloadReference": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "item_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Item Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "item_id"
      ],
      "title": "PayloadReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Event Id",
      "type": "string"
    },
    "kind": {
      "const": "alerts.received",
      "title": "Kind",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "admission_order": {
      "description": "Canonical decimal int64, at most 9223372036854775807",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "title": "Admission Order",
      "type": "string"
    },
    "native_version": {
      "enum": [
        "v1",
        "v2"
      ],
      "title": "Native Version",
      "type": "string"
    },
    "actor_id": {
      "title": "Actor Id",
      "type": "null"
    },
    "cause": {
      "const": "source",
      "title": "Cause",
      "type": "string"
    },
    "received_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "title": "Received At",
      "type": "string"
    },
    "effective_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "title": "Effective At",
      "type": "string"
    },
    "recorded_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "title": "Recorded At",
      "type": "string"
    },
    "payload_ref": {
      "$ref": "#/$defs/PayloadReference"
    },
    "payload_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Digest",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "kind",
    "tenant_id",
    "admission_order",
    "native_version",
    "actor_id",
    "cause",
    "received_at",
    "effective_at",
    "recorded_at",
    "payload_ref",
    "payload_digest"
  ],
  "title": "ReceivedEnvelope",
  "type": "object"
}
